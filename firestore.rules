rules_version = '2';

// Lam Başında canlı oturum kuralları.
// Firebase konsolu → Firestore Database → Rules sekmesine yapıştırıp "Publish" de,
// ya da Firebase CLI ile: firebase deploy --only firestore:rules
//
// Roller:
//   hoca   : Google ile girmiş, aşağıdaki listedeki e-posta. Kumanda ve girişli perde.
//   perde  : Anonim giriş; oturum kodu + bağlantı kodu (pin) ile eşleşmiş ekran.
//   öğrenci: Anonim giriş; oturum koduyla katılır, cevap yazar.

service cloud.firestore {
  match /databases/{database}/documents {

    // Dersi yönetebilecek Google hesapları; birden fazla olabilir.
    function hocaListesi() {
      return ['m.olgun.ak@gmail.com'];
    }

    function girisli() {
      return request.auth != null;
    }

    function hoca() {
      return girisli()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in hocaListesi();
    }

    // Hocanın güvenilir ekranı mı? Kumanda, bir kez kodla eşleşen perdeyi 12 saatliğine buraya yazar.
    function guvenli(code) {
      return girisli()
        && exists(/databases/$(database)/documents/guven/$(get(/databases/$(database)/documents/sessions/$(code)).data.owner)/ekran/$(request.auth.uid))
        && get(/databases/$(database)/documents/guven/$(get(/databases/$(database)/documents/sessions/$(code)).data.owner)/ekran/$(request.auth.uid)).data.t
           > request.time - duration.value(12, 'h');
    }

    // Bu oturuma bağlantı koduyla ya da güvenilir ekran olarak eşleşmiş perde mi?
    function perde(code) {
      return girisli()
        && exists(/databases/$(database)/documents/sessions/$(code)/ekran/$(request.auth.uid))
        && (get(/databases/$(database)/documents/sessions/$(code)/ekran/$(request.auth.uid)).data.pin
              == get(/databases/$(database)/documents/sessions/$(code)/gizli/pin).data.pin
            || guvenli(code));
    }

    function yonetici(code) {
      return hoca() || perde(code);
    }

    // Ders başına açık oturum kaydı: { s: oturum kodu, t: zaman }
    // Öğrenci ekranı buradan açık oturumu bulur; kumanda ve perde canlı dinler.
    match /aktif/{lesson} {
      allow read: if girisli();
      allow write: if hoca();
    }

    // Güvenilir ekranlar: guven/{hocaUid}/ekran/{perdeUid} = { t }. Yalnız hoca yazar.
    match /guven/{owner}/ekran/{uid} {
      allow read: if hoca() || (girisli() && request.auth.uid == uid);
      allow write: if hoca() && request.auth.uid == owner;
    }

    match /sessions/{code} {
      // Oturum belgesi: phase, q, cur, key, n, slide, cmd, board, done.*, opened.*,
      // src ("perde"), wantRemote, remote {uid, t} (kumanda yazar), remoteSeen (perde yazar).
      allow read: if girisli();
      allow create: if hoca() && request.resource.data.owner == request.auth.uid;
      allow update: if yonetici(code);
      allow delete: if false;

      // Bağlantı kodu; yalnız hoca görür.
      match /gizli/{doc} {
        allow read, write: if hoca();
      }

      // Eşleşmiş perdeler: perde kendi belgesini doğru pin ile yazar.
      // Hoca (kumanda) yeni oturum açınca buraya next {code, pin} yazar; perde yeni oturuma kendiliğinden geçer.
      match /ekran/{uid} {
        allow read: if hoca() || (girisli() && request.auth.uid == uid);
        allow create: if girisli()
          && request.auth.uid == uid
          && (request.resource.data.pin
                == get(/databases/$(database)/documents/sessions/$(code)/gizli/pin).data.pin
              || guvenli(code));
        allow update: if hoca() || (girisli()
          && request.auth.uid == uid
          && (request.resource.data.pin
                == get(/databases/$(database)/documents/sessions/$(code)/gizli/pin).data.pin
              || guvenli(code)));
        allow delete: if hoca();
      }

      // Kişi kimliği (pid): takma adı olan için adın anahtarı, anonim için uid.
      // Bir adın altında yalnız adın güncel sahibi (nicks/{ad}.uid) yazabilir; eski cihaz devre dışı kalır.
      function kisi(pid) {
        return pid == request.auth.uid
          || get(/databases/$(database)/documents/sessions/$(code)/nicks/$(pid)).data.uid == request.auth.uid;
      }

      // Katılımcılar: belge adı pid, içerik { nick, uid, t }
      match /participants/{pid} {
        allow read: if yonetici(code);
        allow create, update: if girisli() && kisi(pid);
        allow delete: if hoca();
      }

      // Takma ad kaydı: belge adı küçük harfe çevrilmiş ad, içerik { uid, pin, nick, t }
      // İlk alan sahip olur. Başkası ancak aynı PIN ile (başka cihazdan) devralabilir.
      match /nicks/{key} {
        allow read: if hoca() || (girisli() && resource.data.uid == request.auth.uid);
        allow create: if girisli()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.pin is string
          && request.resource.data.pin.size() >= 4 && request.resource.data.pin.size() <= 8;
        allow update: if girisli()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.pin is string
          && request.resource.data.pin.size() >= 4 && request.resource.data.pin.size() <= 8
          && (resource.data.uid == request.auth.uid || request.resource.data.pin == resource.data.pin);
        allow delete: if hoca();
      }

      // Cevaplar: belge adı "<soruId>_<pid>", içerik { q, pid, uid, v, t, nick }
      match /answers/{doc} {
        allow read: if yonetici(code);
        allow create, update: if girisli()
          && request.resource.data.uid == request.auth.uid
          && doc == request.resource.data.q + '_' + request.resource.data.pid
          && kisi(request.resource.data.pid);
        allow delete: if hoca();
      }
    }
  }
}
